<?xml version="1.0" encoding="utf-8"?>
<!-- Preview shown in the system widget picker: the icon artwork with the "add" badge, matching
     what DrinkWidget renders on the home screen. Both layers get an explicit size so the badge
     keeps the same proportion as in the widget (~36% of the side) at every density. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:drawable="@drawable/ic_widget_icon"
        android:width="96dp"
        android:height="96dp"
        android:gravity="center" />

    <item
        android:drawable="@drawable/ic_widget_add_badge"
        android:gravity="bottom|end"
        android:width="35dp"
        android:height="35dp" />
</layer-list>
