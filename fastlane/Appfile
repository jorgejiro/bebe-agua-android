package_name("com.jjrapps.bebeagua")

# Never inside the repo: the service-account JSON key authenticates as the jjrapps Play Console
# account. SUPPLY_JSON_KEY lets the owner point at wherever they keep it; the default below is
# the shared key used by every jjrapps app, outside the working tree.
json_key_file(ENV["SUPPLY_JSON_KEY"] || File.expand_path("~/.config/play/jjrmobileapps.json"))
